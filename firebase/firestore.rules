rules_version = '2';

// Deny-by-default. All business writes (bookings, deliveries, payments, pricing,
// audit logs) go through Cloud Functions using the Admin SDK, which bypasses
// these rules. Clients may only read what they own and edit a few profile fields.
// See docs/03-roles-permissions.md and docs/10-security.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function hasMfa() {
      return signedIn() && request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null;
    }
    // Staff access additionally requires an MFA session.
    function staffIn(roles) { return role() in roles && hasMfa(); }
    function isOps() { return staffIn(['dispatcher', 'hub_operator', 'finance', 'admin', 'super_admin']); }
    function isAdmin() { return staffIn(['admin', 'super_admin']); }
    function isBusinessMember(businessId) {
      return role() in ['business_owner', 'business_staff']
        && businessId is string
        && request.auth.token.get('businessId', '') == businessId;
    }

    // ---- Identity ---------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false; // role and status are server-managed
    }

    match /customers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['savedAddresses', 'notificationPrefs', 'marketingOptIn', 'defaultPaymentPreference'])
        && (!('savedAddresses' in request.resource.data) || (request.resource.data.savedAddresses is list && request.resource.data.savedAddresses.size() <= 20))
        && (!('marketingOptIn' in request.resource.data) || request.resource.data.marketingOptIn is bool)
        && (!('defaultPaymentPreference' in request.resource.data) || request.resource.data.defaultPaymentPreference in ['mobile_money', 'card', 'cash_on_pickup'])
        && (!('notificationPrefs' in request.resource.data) || (
              request.resource.data.notificationPrefs is map
              && request.resource.data.notificationPrefs.keys().hasOnly(['smsBookingUpdates', 'smsPaymentReceipts', 'emailReceipts'])));
      allow delete: if false;
    }

    match /sellers/{businessId} {
      allow read: if isBusinessMember(businessId) || isAdmin() || staffIn(['finance']);
      allow write: if false;
    }

    match /drivers/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid && role() == 'driver') || isOps() || staffIn(['fleet_manager']);
      allow write: if false;
    }

    match /staff/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    // ---- Public network information --------------------------------------
    match /serviceAreas/{id} { allow read: if true; allow write: if false; }
    match /hubs/{id} { allow read: if true; allow write: if false; }
    match /routes/{id} { allow read: if true; allow write: if false; }

    // ---- Pricing (server-written; staff may read) --------------------------
    match /pricingRules/{version} { allow read: if isOps(); allow write: if false; }
    match /config/{doc} { allow read: if isOps(); allow write: if false; }
    match /contractPricing/{id} {
      allow read: if isBusinessMember(resource.data.businessId) || staffIn(['finance', 'admin', 'super_admin']);
      allow write: if false;
    }

    // ---- Bookings ----------------------------------------------------------
    // Guests read their booking through a function (tracking number + token), never directly.
    match /deliveryRequests/{trackingNumber} {
      allow read: if (signedIn() && resource.data.customerUid == request.auth.uid)
        || isBusinessMember(resource.data.businessId)
        || isOps();
      allow write: if false;
    }

    match /payments/{id} {
      allow read: if (signedIn() && resource.data.customerUid == request.auth.uid)
        || (role() == 'business_owner' && isBusinessMember(resource.data.businessId))
        || staffIn(['finance', 'admin', 'super_admin']);
      allow write: if false;
    }

    match /refunds/{id} {
      allow read: if staffIn(['finance', 'admin', 'super_admin']);
      allow write: if false;
    }

    match /invoices/{id} {
      allow read: if (role() == 'business_owner' && isBusinessMember(resource.data.businessId))
        || staffIn(['finance', 'admin', 'super_admin']);
      allow write: if false;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Server-only: quotes, rate limits, raw payment events, tracking events (served through
    // getTrackingView so guests and recipients see only public messages), notifications, POD secrets and
    // every collection not listed above fall through to deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
