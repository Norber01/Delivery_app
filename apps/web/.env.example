# Firebase web config (public identifiers, not secrets)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Edge Worker base URL (geocoding proxy)
VITE_EDGE_API_URL=http://localhost:8787
# Set to "true" to use the local Firebase emulators
VITE_USE_EMULATORS=false
# Company details shown on the site
VITE_COMPANY_NAME=Your Courier Company
VITE_SUPPORT_PHONE=+233 30 000 0000
