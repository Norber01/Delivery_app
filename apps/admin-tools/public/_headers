  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.google.com https://www.gstatic.com; frame-src https://www.google.com https://recaptcha.google.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebasedatabase.app wss://*.firebasedatabase.app https://*.cloudfunctions.net https://*.run.app https://api.mapbox.com https://events.mapbox.com https://*.workers.dev; img-src 'self' data: blob: https://*.workers.dev https://api.mapbox.com; worker-src blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'
